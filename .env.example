# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact details. Leave empty until verified; the UI shows
# "to be added" placeholders instead of inventing values.
NEXT_PUBLIC_WHATSAPP_NUMBER=      # digits with country code, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Property video on the home page. A file in /public/videos (e.g. /videos/property-tour.mp4),
# a hosted .mp4/.webm URL, or a YouTube / Vimeo link. Leave empty to show "coming soon".
NEXT_PUBLIC_PROPERTY_VIDEO_URL=
# Optional cover image for the video (defaults to a stock building photo)
NEXT_PUBLIC_PROPERTY_VIDEO_POSTER=

# Server-only. When set, /api/inquiries forwards each validated inquiry here
# as JSON (e.g. a Zapier/Make webhook or your own backend). Never prefix with NEXT_PUBLIC_.
INQUIRY_WEBHOOK_URL=

# Set to "false" to hide the demo admin (/admin) in production until real auth exists.
ADMIN_DEMO_ENABLED=true

# Future database integration (see prisma/schema.prisma and README)
DATABASE_URL=
